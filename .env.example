# ─────────────────────────────────────────────────────────────────────────────
# AI-HIDS Sentinel — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and replace the placeholder values.

# ── JWT Secret (REQUIRED) ─────────────────────────────────────────────────────
# 64-byte cryptographically random hex string.
# Generate a new one: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=

# Token lifetime in minutes (default: 480 = 8 hours)
JWT_EXPIRE_MINUTES=480

# ── MongoDB Atlas (REQUIRED) ──────────────────────────────────────────────────
# Connection string from MongoDB Atlas. TLS is enforced automatically.
MONGODB_URI=
MONGODB_DB_NAME=hids_sentinel

# ── First-run Admin Account (REQUIRED for initial seed) ───────────────────────
# Used ONLY to create the first user in MongoDB on a fresh database.
# Minimum password length: 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Gemini AI (Optional) ──────────────────────────────────────────────────────
# Leave empty to use local ML (IsolationForest) for process classification.
GEMINI_API_KEY=

# ── SOAR Engine ───────────────────────────────────────────────────────────────
SOAR_ENABLED=true
SOAR_ALERT_THRESHOLD=85.0
SOAR_WEBHOOK_URL=
SOAR_REQUIRE_APPROVAL=true
